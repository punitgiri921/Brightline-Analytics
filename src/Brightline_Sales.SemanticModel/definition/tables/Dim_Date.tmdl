	partition Dim_Date = calculated
		mode: import
		source = ```
				
				VAR MinYear = 2023
				VAR MaxYear = 2026
				VAR DateTable = 
				    CALENDAR(DATE(MinYear, 1, 1), DATE(MaxYear, 12, 31))
				RETURN
				    ADDCOLUMNS(
				        DateTable,
				        "Year", YEAR([Date]),
				        "Quarter", "Q" & FORMAT([Date], "Q"),
				        "YearQuarter", YEAR([Date]) & "-Q" & FORMAT([Date], "Q"),
				        "MonthNum", MONTH([Date]),
				        "MonthName", FORMAT([Date], "mmm"),
				        "YearMonth", FORMAT([Date], "yyyy-mm"),
				        "YearMonthSort", YEAR([Date]) * 100 + MONTH([Date]),
				        "DayOfWeek", WEEKDAY([Date], 2), -- 1=Monday, 7=Sunday
				        "DayName", FORMAT([Date], "ddd"),
				        "IsWeekend", IF(WEEKDAY([Date], 2) IN {6, 7}, 1, 0)
				    )
				
				```

	annotation PBI_Id = e4443b54a65440b68a09a12bf53ae396

